defmodule <%= @web_module %>.App.HomePage do
  @moduledoc """
  The home page, `/`. Generated by `mix xenia.install`; it's yours now.

  Its folder is its URL: `<%= @app_folder %>/page.ex` is `/`, and
  `<%= @app_folder %>/about/page.ex` would be `/about`.
  """
  use <%= @web_module %>, :live_view
  use Xenia.Page

  @impl true
  def mount(_params, _session, socket) do
    {:ok, socket}
  end

  # The page's <title>: "Welcome · <%= @app_title %>", through the layout's template.
  def metadata(_assigns), do: %{title: "Welcome"}

  @impl true
  def render(assigns) do
    ~H"""
    <section class="py-12 text-center sm:py-20">
      <img src={~p"/images/xenia-mark.png"} alt="" width="56" height="56" class="mx-auto" />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl"><%= @app_title %></h1>
      <p class="mx-auto mt-4 max-w-xl text-lg opacity-70">
        A Phoenix app with Xenia: pages rendered on the server, and JavaScript where it helps.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="https://hexdocs.pm/xenia" class="btn btn-primary">Read the docs</a>
        <a href="https://hexdocs.pm/xenia/wrapping-a-library.html" class="btn">Wrap a library</a>
      </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-box border border-base-300 bg-base-100 p-5">
        <h2 class="font-semibold">Pages from folders</h2>
        <p class="mt-2 text-sm opacity-70">
          This page is <code><%= @app_folder %>/page.ex</code>. Add a folder with a <code>page.ex</code>, and it's a new URL.
        </p>
      </div>
      <div class="rounded-box border border-base-300 bg-base-100 p-5">
        <h2 class="font-semibold">JavaScript islands</h2>
        <p class="mt-2 text-sm opacity-70">
          Bring in any JavaScript library: <code>mix xenia.gen.component chart data:map</code>
          writes its adapter and its tag.
        </p>
      </div>
      <div class="rounded-box border border-base-300 bg-base-100 p-5">
        <h2 class="font-semibold">Official adapters</h2>
        <p class="mt-2 text-sm opacity-70">
          Monaco, Chart.js, Tiptap, Leaflet and more, ready to configure and extend.
        </p>
      </div>
    </section>
    """
  end
end
