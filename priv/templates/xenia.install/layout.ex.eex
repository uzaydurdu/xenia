defmodule <%= @web_module %>.App.RootLayout do
  @moduledoc """
  The layout around every page in `<%= @app_folder %>`: a header, the page,
  and the flash messages. Generated by `mix xenia.install`; it's yours now.

  A `layout.ex` in a deeper folder frames only the pages below it, inside
  this one.
  """
  use <%= @web_module %>, :html
  use Xenia.Layout

  # The defaults for every page's <title> and <head> tags (Xenia.Metadata).
  # A page's own metadata/1 can set its title; the template wraps it.
  @impl true
  def metadata(_assigns) do
    %{
      title: "<%= @app_title %>",
      title_template: "%s · <%= @app_title %>",
      description: "<%= @app_title %>, built with Phoenix and Xenia."
    }
  end

  @impl true
  def frame(assigns) do
    ~H"""
    <div class="relative isolate min-h-screen">
      <div class="xenia-grid pointer-events-none absolute inset-x-0 top-0 -z-10 h-[28rem]"></div>

      <header class="sticky top-0 z-30 border-b border-base-300 bg-base-100/80 backdrop-blur">
        <div class="mx-auto flex h-14 max-w-5xl items-center gap-3 px-4 sm:px-6">
          <.link navigate="/" class="flex items-center gap-2 font-semibold tracking-tight">
            <img src={~p"/images/xenia-mark.png"} alt="" width="22" height="22" />
            <span><%= @app_title %></span>
          </.link>
          <nav class="ml-auto flex items-center gap-1 text-sm">
            <a href="https://hexdocs.pm/xenia" class="btn btn-ghost btn-sm">Docs</a>
            <Layouts.theme_toggle />
          </nav>
        </div>
      </header>

      <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
        {@inner_content}
      </main>

      <footer class="mx-auto max-w-5xl px-4 pb-10 text-sm opacity-60 sm:px-6">
        Built with Phoenix and Xenia.
      </footer>

      <Layouts.flash_group flash={@flash} />
    </div>
    """
  end
end
