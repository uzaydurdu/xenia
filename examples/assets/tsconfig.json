// Editor autocompletion for LiveView's JavaScript API (Phoenix generates
// this file), and the type check for this app's TypeScript islands:
// `npm run typecheck`. Only .ts files, and .js files that start with
// `// @ts-check`, are checked.
//
// Changed from what Phoenix 1.8 generates:
//   - no `baseUrl`: TypeScript 7 removed it, and `paths` are relative to
//     this file anyway;
//   - `module`, `moduleResolution`, `target`, `lib` and `strict`, so imports
//     resolve the way esbuild resolves them, and `skipLibCheck`.
//
// Here "xenia" resolves through node_modules (package.json links it). In
// an app with Xenia from Hex, add two lines to `paths` (see Xenia's guide,
// "Typed adapters"):
//   "xenia": ["../deps/xenia/priv/types/xenia.d.ts"],
//   "xenia/*": ["../deps/xenia/priv/types/*.d.ts"]
{
  "compilerOptions": {
    "paths": {
      "*": ["../deps/*"]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    // Libraries' own declaration files aren't this app's to fix.
    "skipLibCheck": true
  },
  "include": ["js/**/*"]
}
